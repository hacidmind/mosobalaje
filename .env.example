# Required: use a local database or your MongoDB Atlas connection string.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="mosobalaje_imports"

# Absolute public URL for metadata; change when deploying.
APP_URL="http://localhost:3000"

# Authentication. Run `npm run auth:provision` to generate these values.
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_ADMIN_EMAIL="admin@example.com"
AUTH_ADMIN_PASSWORD_HASH="scrypt$..."
AUTH_ADMIN_TOTP_SECRET="BASE32SECRET"
AUTH_CEO_EMAIL="ceo@example.com"
AUTH_CEO_PASSWORD_HASH="scrypt$..."
AUTH_CEO_TOTP_SECRET="BASE32SECRET"
CEO_PORTAL_SLUG="replace-with-a-random-value-at-least-24-characters-long"

# Business contacts and homepage copy are managed in the database settings.
